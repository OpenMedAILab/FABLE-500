# Copy this file to `.env` and fill in only the providers you plan to use.
# Do not commit `.env`.

# OpenRouter providers used for GPT-5.6 Sol, Gemini 3.7 Flash, and Claude Sonnet 5.
OPENROUTER_API_KEY=

# Bailian-compatible provider used for Qwen3.7 Plus.
BAILIAN_API_KEY=

# Optional direct OpenAI provider.
OPENAI_API_KEY=

# Optional proxy for environments that require it, e.g. http://127.0.0.1:7890
FABLE500_PROXY_URL=

# Optional model overrides. Defaults match the manuscript benchmark settings.
FABLE500_OPENROUTER_GPT56_SOL_MODEL=openai/gpt-5.6-sol
FABLE500_OPENROUTER_GEMINI37_MODEL=google/gemini-3.7-flash
FABLE500_OPENROUTER_CLAUDE_MODEL=anthropic/claude-sonnet-5
FABLE500_BAILIAN_VISION_MODEL=qwen3.7-plus

